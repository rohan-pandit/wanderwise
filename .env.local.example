# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# From `npx supabase status` once local Supabase is running (see README/BUILD_LOG),
# or from the Supabase dashboard for a hosted project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses RLS. Used exclusively by
# src/config/supabase/service.ts for internal/telemetry tables. Never
# prefix this with NEXT_PUBLIC_ and never send it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Embeddings for destination/activity semantic retrieval (src/retrieval).
# https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=

# Live flight search (src/repositories/providers/serpapi-flight-provider.ts).
# Required unconditionally — there's no seeded-data fallback in app/app/actions.ts.
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# The one email address allowed into /internal/* (engineering + product
# dashboards) — checked in proxy.ts. Unset denies everyone. See
# app/internal/analytics/page.tsx for why this is a single allowlisted
# address rather than a role system.
INTERNAL_ACCESS_EMAIL=
