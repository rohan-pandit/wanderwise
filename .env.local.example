# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# From `npx supabase status` once local Supabase is running (see README/BUILD_LOG),
# or from the Supabase dashboard for a hosted project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses RLS. Used exclusively by
# src/config/supabase/service.ts for internal/telemetry tables. Never
# prefix this with NEXT_PUBLIC_ and never send it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Embeddings for destination/activity semantic retrieval (src/retrieval).
# https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=
